# 필요한 환경변수 목록. 값은 비운다. 커밋한다.
# 운영 값은 Vercel 대시보드의 환경변수로 넣는다. .env.production 파일은 만들지 않는다.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_KAKAO_CLIENT_ID=
VITE_NAVER_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# 개발 전용. 로고 더블클릭 개발용 로그인이 쓰는 테스트 providerId. .env.development 에 기본값 있음.
VITE_DEV_PROVIDER_ID=

# 배포본에서 개발용 로그인을 열 때만 'true'. Vercel Preview 스코프에만 넣는다.
# Production(main)에는 넣지 않는다 — 넣으면 주소를 아는 누구나 토큰을 받는다.
# 로컬은 이 값이 없어도 열린다. 제출 전 삭제한다.
VITE_DEV_LOGIN=
